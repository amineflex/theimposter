# ---------------------------------------------------------------------------
# The Imposter — variables d'environnement
# Copier ce fichier vers .env.local puis remplir les valeurs.
# ---------------------------------------------------------------------------

# --- PUBLIC (exposé au navigateur) ----------------------------------------
# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Supabase > Project Settings > API > anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# URL publique du site (utilisée pour les liens de partage / QR code / OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SERVEUR UNIQUEMENT (ne jamais préfixer par NEXT_PUBLIC_) -------------
# Supabase > Project Settings > API > service_role key.
# Utilisée exclusivement par les route handlers Next.js (source de vérité du
# jeu). Ne doit JAMAIS être importée dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Secret partagé protégeant l'endpoint de maintenance /api/cron/cleanup
# (expiration des rooms). Générer avec: openssl rand -hex 32
CRON_SECRET=change-me
